# Optional: only needed if you outgrow the bundled local JSON data
# and move datasets to Cloudflare R2 (S3-compatible) storage.
# If these are left unset, the backend automatically reads from
# backend/data/*.json (bundled in the repo, works out of the box).

R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=living-earth-data
R2_PREFIX=v1/

# Used for CORS in production (your Vercel production URL)
FRONTEND_URL=
